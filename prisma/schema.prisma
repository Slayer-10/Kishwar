generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  FDO
  AMBASSADOR
  PARTICIPANT
}

enum RegistrationType {
  INDIVIDUAL
  TEAM
  BOTH
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  INVOICED
  PAID
  CONFIRMED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentVerificationStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum TicketStatus {
  VALID
  USED
  INVALID
}

enum AmbassadorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationReviewStatus {
  PENDING_AMBASSADOR
  PENDING_ADMIN
  APPROVED
  REJECTED
}

enum RegistrationSource {
  PUBLIC
  AMBASSADOR
}

enum RegistrationEvidenceType {
  STUDENT_DOCUMENT
  PAYMENT_PROOF
}

enum EvidenceReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AccommodationSelection {
  NONE_OR_ALREADY_ARRANGED
  THREE_DAY_STAY_WITH_FOOD
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String?
  role         Role     @default(PARTICIPANT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ambassador                   Ambassador?
  fdo                          FDO?
  participant                  Participant?
  verifiedPayments             Payment[]              @relation("PaymentVerifiedBy")
  verifiedCampusPayments       CampusPayment[]        @relation("CampusPaymentVerifiedBy")
  auditLogs                    AuditLog[]
  ambassadorRequests           AmbassadorRequest[]    @relation("AmbassadorRequestReviewer")
  collectiveInvoicesGenerated  CollectiveInvoice[]    @relation("CollectiveInvoiceGeneratedBy")
  uploadedRegistrationEvidence RegistrationEvidence[] @relation("RegistrationEvidenceUploadedBy")
  reviewedRegistrationEvidence RegistrationEvidence[] @relation("RegistrationEvidenceReviewedBy")

  @@index([role])
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique
  city      String?
  createdAt DateTime @default(now())

  ambassadors        Ambassador[]
  teams              Team[]
  ambassadorRequests AmbassadorRequest[]
  participants       Participant[]
}

model Ambassador {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id])
  universityId   String
  university     University @relation(fields: [universityId], references: [id])
  ambassadorCode String     @unique
  assignedAt     DateTime   @default(now())

  teams              Team[]
  registrations      Registration[]
  campusPayments     CampusPayment[]
  collectiveInvoices CollectiveInvoice[]

  @@index([universityId])
}

model FDO {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  assignedScope Json?
  createdAt     DateTime @default(now())
}

model Participant {
  id             String   @id @default(uuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  fullName       String
  email          String   @unique
  phone          String?
  cnic           String?
  normalizedCnic String?
  createdAt      DateTime @default(now())

  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  captainOfTeams       Team[]                 @relation("TeamCaptain")
  teamMemberships      TeamMember[]
  registrations        Registration[]
  ambassadorRequests   AmbassadorRequest[]
  registrationEvidence RegistrationEvidence[]

  @@index([universityId])
  @@index([normalizedCnic])
}

model AmbassadorRequest {
  id String @id @default(uuid())

  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id])

  fullName       String?
  email          String?
  phone          String?
  gender         String?
  cnic           String?
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id])
  occupation     String?
  degree         String?
  semester       Int?
  studentCardUrl String?
  message        String?

  reviewedById String?
  reviewedBy   User?                   @relation("AmbassadorRequestReviewer", fields: [reviewedById], references: [id])
  status       AmbassadorRequestStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  reviewedAt   DateTime?

  @@index([email])
  @@index([participantId])
  @@index([status])
  @@index([universityId])
}

model Team {
  id           String      @id @default(uuid())
  name         String
  captainId    String
  captain      Participant @relation("TeamCaptain", fields: [captainId], references: [id])
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  ambassadorId String?
  ambassador   Ambassador? @relation(fields: [ambassadorId], references: [id])
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id])
  createdAt    DateTime    @default(now())

  members       TeamMember[]
  registrations Registration[]

  @@index([eventId])
  @@index([universityId])
  @@index([ambassadorId])
}

model TeamMember {
  id            String      @id @default(uuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  @@unique([teamId, participantId])
  @@index([participantId])
}

model Event {
  id               String           @id @default(uuid())
  name             String           @unique
  description      String?
  category         String?
  registrationFee  Decimal          @db.Decimal(10, 2)
  prizeMoney       Decimal?         @db.Decimal(10, 2)
  registrationType RegistrationType
  minTeamSize      Int?
  maxTeamSize      Int?
  seatCapacity     Int?
  deadline         DateTime
  eventDate        DateTime
  venue            String?
  rules            String?
  status           EventStatus      @default(DRAFT)
  createdAt        DateTime         @default(now())

  teams              Team[]
  registrations      Registration[]
  collectiveInvoices CollectiveInvoice[]

  @@index([status])
}

model Registration {
  id            String       @id @default(uuid())
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id])
  teamId        String?
  team          Team?        @relation(fields: [teamId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])

  ambassadorId String?
  ambassador   Ambassador? @relation(fields: [ambassadorId], references: [id])

  status                 RegistrationStatus       @default(PENDING)
  reviewStatus           RegistrationReviewStatus @default(PENDING_ADMIN)
  source                 RegistrationSource       @default(PUBLIC)
  seatReserved           Boolean                  @default(false)
  accommodationSelection AccommodationSelection   @default(NONE_OR_ALREADY_ARRANGED)
  accommodationGender    String?
  accommodationFee       Decimal?                 @db.Decimal(10, 2)
  ambassadorApprovedAt   DateTime?
  adminApprovedAt        DateTime?
  rejectionReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice               Invoice?
  ticket                Ticket?
  evidence              RegistrationEvidence[]
  collectiveInvoiceItem CollectiveInvoiceItem?

  @@index([eventId])
  @@index([status])
  @@index([participantId])
  @@index([teamId])
  @@index([ambassadorId])
  @@index([reviewStatus])
  @@index([seatReserved, eventId])
  @@index([source])
}

model RegistrationEvidence {
  id String @id @default(uuid())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  type         RegistrationEvidenceType
  reviewStatus EvidenceReviewStatus     @default(PENDING)

  storagePath      String
  originalFileName String?
  contentType      String?
  byteSize         BigInt?

  uploadedByUserId String?
  uploadedBy       User?   @relation("RegistrationEvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  reviewedByUserId String?
  reviewedBy       User?   @relation("RegistrationEvidenceReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  @@index([registrationId])
  @@index([participantId])
  @@index([type, reviewStatus])
  @@index([reviewedByUserId])
}

model Invoice {
  id             String        @id @default(uuid())
  registrationId String        @unique
  registration   Registration  @relation(fields: [registrationId], references: [id])
  invoiceNumber  String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  campusPaymentId String?
  campusPayment   CampusPayment? @relation(fields: [campusPaymentId], references: [id])

  payments Payment[]

  @@index([campusPaymentId])
}

model CollectiveInvoice {
  id String @id @default(uuid())

  ambassadorId String
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)

  scopeKey      String
  invoiceNumber String @unique

  status InvoiceStatus @default(PENDING)

  subtotal        Decimal @db.Decimal(10, 2)
  discountPercent Decimal @db.Decimal(5, 2)
  discountAmount  Decimal @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)

  generatedById String
  generatedBy   User   @relation("CollectiveInvoiceGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   CollectiveInvoiceItem[]
  Event   Event?                  @relation(fields: [eventId], references: [id])
  eventId String?

  @@unique([ambassadorId, scopeKey])
  @@index([ambassadorId, status])
  @@index([status, createdAt])
}

model CollectiveInvoiceItem {
  id String @id @default(uuid())

  collectiveInvoiceId String
  collectiveInvoice   CollectiveInvoice @relation(fields: [collectiveInvoiceId], references: [id], onDelete: Restrict)

  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  baseAmount     Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  finalAmount    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([collectiveInvoiceId])
}

model DiscountTier {
  id String @id @default(uuid())

  name                 String  @unique
  minimumRegistrations Int     @unique
  discountPercent      Decimal @db.Decimal(5, 2)
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, minimumRegistrations])
}

model CampusPayment {
  id                 String                    @id @default(uuid())
  ambassadorId       String
  ambassador         Ambassador                @relation(fields: [ambassadorId], references: [id])
  totalAmount        Decimal                   @db.Decimal(10, 2)
  method             String
  referenceNumber    String?
  proofUrl           String?
  verificationStatus PaymentVerificationStatus @default(SUBMITTED)
  verifiedBy         String?
  verifier           User?                     @relation("CampusPaymentVerifiedBy", fields: [verifiedBy], references: [id])
  createdAt          DateTime                  @default(now())

  invoices Invoice[]

  @@index([ambassadorId])
  @@index([verificationStatus])
}

model Payment {
  id                 String                    @id @default(uuid())
  invoiceId          String
  invoice            Invoice                   @relation(fields: [invoiceId], references: [id])
  amount             Decimal                   @db.Decimal(10, 2)
  method             String
  referenceNumber    String?
  proofUrl           String?
  batchId            String?
  verificationStatus PaymentVerificationStatus @default(SUBMITTED)
  verifiedBy         String?
  verifier           User?                     @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])
  createdAt          DateTime                  @default(now())

  @@index([invoiceId])
  @@index([verificationStatus])
  @@index([batchId])
}

model Ticket {
  id             String       @id @default(uuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id])
  ticketCode     String       @unique
  qrData         String
  status         TicketStatus @default(VALID)
  createdAt      DateTime     @default(now())
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([isPublished])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  targetTable String
  targetId    String
  timestamp   DateTime @default(now())
  details     Json?

  @@index([userId])
  @@index([targetTable, targetId])
}
